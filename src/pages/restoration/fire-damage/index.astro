---
import LocalServiceLinks from "../../../components/LocalServiceLinks.astro";
import ProjectPhoto from "../../../components/ProjectPhoto.astro";
import { SERVICE_IMAGERY } from "../../../data/project-imagery";
import ServiceFAQ from "../../../components/ServiceFAQ.astro";
import InsuranceSupport from "../../../components/InsuranceSupport.astro";
import ServiceFacts from "../../../components/ServiceFacts.astro";
import { SERVICE_FAQS } from "../../../data/service-faqs";
import ProjectExamples from "../../../components/ProjectExamples.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { COMPANY , REGIONS } from "../../../data/company";
import Icon from "../../../components/Icon.astro";

const title = "Fire & Smoke Damage Restoration in South Florida | Paramount";
const description = "Fire and smoke damage restoration in South Florida. Discuss affected surfaces, contents, firefighting water and the proposed work. Contact us 24/7.";
---

<BaseLayout title={title} description={description} path="/restoration/fire-damage/">
<div class="wrap-wide"><nav class="crumb"><a href="/">Home</a><span>/</span><a href="/restoration/">Restoration</a><span>/</span> Fire & Smoke Damage</nav></div>
<section class="phero"><div class="wrap-wide"><div class="phero-grid">
  <div class="reveal">
    <span class="eyebrow">Emergency Service · 24/7 · South Florida</span>
    <h1 class="h1 mt-s">Fire & Smoke Damage Restoration</h1>
    <p class="empathy">After a fire, discuss access, affected materials and the next step.</p>
    <p class="lead maxw mt-m">A fire can affect surfaces, contents and materials exposed to smoke or firefighting water. <strong>An assessment defines the work proposed</strong> and any specialist repairs needed.</p>
    <div class="chips mt-m"><span class="chip">24/7 contact</span><span class="chip">IICRC certified</span><span class="chip">Project documentation</span><span class="chip">24/7 · 365</span></div>
    <ProjectPhoto selection={SERVICE_IMAGERY["fire-damage"]} eager />
  </div>
  <aside class="reveal"><div class="emcard">
    <div class="eyebrow nodash" style="color:#9db8ff;">Need help now?</div>
    <h3 class="mt-s">Talk to a certified crew.</h3>
    <a href={`tel:${COMPANY.phoneRaw}`} class="phone">{COMPANY.phone}</a>
    <div class="ph-note">Call to discuss availability · 24/7</div>
    <hr>
    <form data-emergency class="ef-mini" name="fire-damage" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="fire-damage" /><p hidden aria-hidden="true"><label>Do not fill this out<input name="bot-field" /></label></p><div style="display:flex;flex-direction:column;gap:.9rem;">
      <div class="field"><label for="fire-damage-name">Your name</label><input type="text" name="name" required placeholder="Full name" id="fire-damage-name" autocomplete="name" aria-describedby="fire-damage-name-error"><span class="msg" id="fire-damage-name-error">Enter your name</span></div>
      <div class="field"><label for="fire-damage-phone">Phone</label><input type="tel" name="phone" required placeholder="(000) 000-0000" id="fire-damage-phone" autocomplete="tel" aria-describedby="fire-damage-phone-error"><span class="msg" id="fire-damage-phone-error">Enter a valid phone</span></div>
      <div class="field"><label for="fire-damage-service">What happened?</label><select name="service" required id="fire-damage-service" aria-describedby="fire-damage-service-error"><option value="">Select…</option><option>Active fire damage</option><option>Smoke & soot cleanup</option><option>Smoke odor removal</option><option>Contents recovery</option><option>Water from firefighting</option></select><span class="msg" id="fire-damage-service-error">Choose one</span></div>
    </div>
    <button class="btn btn-alert btn-block mt-m" type="submit">Request callback</button>
    <p data-error role="alert" tabindex="-1" hidden style="color:#fff;margin-top:1rem;">We couldn't confirm receipt of your request. Please try again or <a href={`tel:${COMPANY.phoneRaw}`} style="color:#fff;text-decoration:underline;">call {COMPANY.phone}</a> for urgent help.</p>
    <div data-success role="status" tabindex="-1" style="display:none;text-align:center;padding:1rem 0;"><svg viewBox="0 0 24 24" fill="none" stroke="#46c37b" stroke-width="2" width="34" height="34" style="margin:0 auto .6rem;"><path d="M20 6L9 17l-5-5"/></svg><p style="color:#fff;font-weight:600;">Request received.</p><p style="color:#9db8ff;font-size:.9rem;">A dispatcher will call within minutes.</p></div>
    </form>
    <hr>
    <ul class="ef-list"><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Ask about insurance documentation</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Discuss the assessment scope and cost</li></ul>
  </div></aside>
</div></div></section>
<ServiceFacts />
<section class="pt pb"><div class="wrap-wide">
  <div class="sec-head reveal"><div><span class="eyebrow">01, What we handle</span><h2 class="h2 mt-s" style="max-width:20ch;">Fire, smoke, soot, and the water that follows.</h2></div><p class="body-l" style="max-width:32ch;">The assessment considers the types of damage observed and the work required for each area.</p></div>
  <div class="types mt-l"><div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c1.5 3.5 5 4.5 5 9a5 5 0 0 1-10 0c0-2 1-3.5 2-5 .5 2.5 3 2.5 3 0z"/></svg><h3>Smoke & soot residue</h3><p>Discuss cleaning appropriate to the residue and affected surfaces.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12c4-4 12-4 16 0M7 15c3-3 7-3 10 0M10 18c1.5-1.5 2.5-1.5 4 0"/></svg><h3>Smoke odor removal</h3><p>Odor treatment depends on affected materials and the source identified.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="16" height="16" rx="1.5"/><path d="M9 9h6v6H9z"/></svg><h3>Contents & textiles</h3><p>Assess items for cleaning, specialist recovery or replacement.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 21h18M5 21V8l7-5 7 5v13"/><path d="M9 21v-7h6v7"/></svg><h3>Structural char & cleanup</h3><p>Removal of charred materials and debris, safely handled.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 16c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"/></svg><h3>Water from firefighting</h3><p>The water used to put it out causes its own damage, we dry it.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><h3>Electronics & documents</h3><p>Discuss whether specialist recovery is appropriate for the affected items.</p></div></div>
</div></section>
<section class="pb"><div class="wrap-wide">
  <div class="sec-head reveal"><div><span class="eyebrow">02, The process</span><h2 class="h2 mt-s" style="max-width:18ch;">Assess the damage and agree the work.</h2></div></div>
  <div class="steps mt-l"><div class="step reveal"><div class="n">01 / Assess</div><div><h3 class="h3">Assess & secure</h3><div class="sd"><p>We discuss accessible areas and observed damage; structural safety may require a qualified specialist.</p><p>Safety first, then a clear plan and scope.</p></div></div></div>
      <div class="step reveal"><div class="n">02 / Secure</div><div><h3 class="h3">Board-up & tarp</h3><div class="sd"><p>Temporary protection may form part of the scope once access and conditions are confirmed.</p><p>Ask what temporary measures are included and their limitations.</p></div></div></div>
      <div class="step reveal"><div class="n">03 / Clean</div><div><h3 class="h3">Soot & smoke removal</h3><div class="sd"><p>We clean soot from surfaces and contents before acidic residue sets in.</p><p>Recovery depends on material condition and the extent of damage.</p></div></div></div>
      <div class="step reveal"><div class="n">04 / Deodorize</div><div><h3 class="h3">Odor neutralization</h3><div class="sd"><p>The proposed odor treatment depends on the assessment and affected materials.</p><p>Discuss the treatment plan and its limitations before work begins.</p></div></div></div>
      <div class="step reveal"><div class="n">05 / Restore</div><div><h3 class="h3">Restore & dry out</h3><div class="sd"><p>The scope can include drying water-affected materials and identifying further repair needs.</p><p>Confirm who is responsible for restoration and any specialist repairs.</p></div></div></div></div>
</div></section>
<section class="insight"><div class="wrap-wide"><div class="insight-in reveal">
  <span class="eyebrow nodash" style="color:#9db8ff;">Don't forget</span>
  <p class="h2" style="color:#fff;max-width:24ch;">The fire's out. The <em>water isn't done.</em></p>
  <p class="lead" style="color:#aac3ff;max-width:46ch;">Water used during firefighting can affect materials beyond the visibly burned area. The assessment should consider moisture and any drying work needed.</p>
  <a href="/restoration/water-damage/" class="link-arrow" style="color:#fff;">See water damage restoration <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a>
</div></div></section>
<!-- EDITORIAL BODY (keywords del sheet) -->
<section class="pb">
  <div class="wrap-wide">
    <div class="insure-in reveal" style="align-items:start;">
      <div class="prose">
        <span class="eyebrow">Fire, smoke and soot, fully handled</span>
        <h2 class="h2 mt-s" style="max-width:24ch;">Fire damage restoration that addresses the fire and everything it leaves behind.</h2>
        <p><strong>Fire damage restoration</strong> can involve heat-affected materials, smoke residue, contents and water used during firefighting. The assessment determines which areas can be inspected and what work is appropriate once access is permitted.</p>
        <p><strong>Smoke and soot cleanup</strong> depends on the surfaces and materials involved. Cleaning, contents treatment and odor work should be proposed for the conditions observed. Some items may require specialist evaluation or may not be recoverable.</p>
        <p>Where firefighting water has affected materials, the proposed scope can include extraction, drying and progress checks. Discuss the sequence, documentation and any specialist structural, electrical or other repairs separately. A photo or initial call cannot establish the full repair scope.</p>
      </div>
      <div>
        <div class="pullcard"><span class="num-label">What we handle</span><p style="font-family:var(--serif);font-weight:300;font-size:1.4rem;line-height:1.3;margin-top:.5rem;color:var(--ink);">Discuss fire, smoke, soot and water-affected materials as part of the assessment.</p></div>
        <ul class="risk-list" style="margin-top:1rem;">
          <li><span class="risk-ico"><Icon name="fire" size={18} /></span> Fire damage restoration & repair</li>
          <li><span class="risk-ico"><Icon name="wave" size={18} /></span> Smoke & soot cleanup</li>
          <li><span class="risk-ico"><Icon name="inspect" size={18} /></span> Odor neutralization</li>
          <li><span class="risk-ico"><Icon name="home" size={18} /></span> Drying and repair scope</li>
        </ul>
      </div>
    </div>
  </div>
</section>
<ProjectExamples cities={["miami", "cape-coral", "port-st-lucie"]} />
<InsuranceSupport />
<section class="pb"><div class="wrap-wide">
  <div class="sec-head reveal"><div><span class="eyebrow">04, Common questions</span><h2 class="h2 mt-s">Fire & Smoke Damage, answered.</h2></div></div>
  <ServiceFAQ items={SERVICE_FAQS["fire-damage"]} />
</div></section>
<section class="areas pt pb"><div class="wrap-wide reveal">
  <span class="eyebrow">Where we serve</span><h2 class="h2 mt-s" style="max-width:24ch;">Fire & Smoke Damage across South Florida.</h2>
  <div class="citylinks mt-m">{REGIONS.flatMap((r) => r.cities).map((c) => (<a href={`/service-areas/${c.slug}/`}>{c.name}</a>))}</div>
</div></section>
<section class="pb"><div class="wrap-wide">
  <div class="sec-head reveal"><div><span class="eyebrow">Related services</span><h2 class="h2 mt-s">Keep exploring</h2></div></div>
  <div class="rel-grid mt-l"><a href="/restoration/water-damage/" class="rel reveal"><div><span class="num-label">Related service</span><h3 style="margin-top:.3rem;">Water Damage Restoration</h3></div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a>
      <a href="/restoration/mold-remediation/" class="rel reveal"><div><span class="num-label">Related service</span><h3 style="margin-top:.3rem;">Mold Remediation</h3></div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a></div>
</div></section>
<LocalServiceLinks heading="Fire and smoke help in Bonita Springs" description="Review soot cleanup, affected contents, odor concerns and water from firefighting before requesting an assessment." links={[{ href: "/service-areas/bonita-springs/#fire-smoke", label: "Bonita Springs fire and smoke restoration" }]} />
<section class="emcta"><div class="wrap-wide emcta-in reveal">
  <div><span class="eyebrow nodash" style="color:#ffd2c4;">Act fast</span><h2 class="display" style="color:#fff;max-width:16ch;">Discuss the next step after a fire.</h2></div>
  <div class="emcta-actions"><a href={`tel:${COMPANY.phoneRaw}`} class="btn btn-lg" style="background:#fff;color:var(--alert);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg> Call {COMPANY.phone}</a><a href="/emergency/" class="btn btn-lg btn-block" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5);">Request help online <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
</div></section>
</BaseLayout>
---
import ProjectPhoto from "../../../components/ProjectPhoto.astro";
import { SERVICE_IMAGERY } from "../../../data/project-imagery";
import ServiceFAQ from "../../../components/ServiceFAQ.astro";
import InsuranceSupport from "../../../components/InsuranceSupport.astro";
import ServiceFacts from "../../../components/ServiceFacts.astro";
import { SERVICE_FAQS } from "../../../data/service-faqs";
import ProjectExamples from "../../../components/ProjectExamples.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { COMPANY , REGIONS } from "../../../data/company";
import Icon from "../../../components/Icon.astro";

const title = "Mold Testing & Inspection in South Florida | Paramount";
const description = "Mold inspection and testing information in South Florida. Discuss scope, sampling, reporting, professional roles and follow-up before booking.";
---

<BaseLayout title={title} description={description} path="/restoration/mold-testing/">
<div class="wrap-wide"><nav class="crumb"><a href="/">Home</a><span>/</span><a href="/restoration/">Restoration</a><span>/</span> Mold Testing & Inspection</nav></div>
<section class="phero"><div class="wrap-wide"><div class="phero-grid">
  <div class="reveal">
    <span class="eyebrow">Inspection & Testing · South Florida</span>
    <h1 class="h1 mt-s">Mold Testing & Inspection in South Florida</h1>
    <p class="empathy">Discuss the concern and the question an inspection should answer.</p>
    <p class="lead maxw mt-m">Understand the proposed inspection, any sampling and the limits of the findings. <strong>Confirm professional roles, scope and reporting before booking.</strong></p>
    <div class="chips mt-m"><span class="chip">24/7 contact</span><span class="chip">IICRC certified</span><span class="chip">Project documentation</span><span class="chip">24/7 · 365</span></div>
    <ProjectPhoto selection={SERVICE_IMAGERY["mold-testing"]} eager />
  </div>
  <aside class="reveal"><div class="emcard">
    <div class="eyebrow nodash" style="color:#9db8ff;">Want answers?</div>
    <h3 class="mt-s">Book an inspection.</h3>
    <a href={`tel:${COMPANY.phoneRaw}`} class="phone">{COMPANY.phone}</a>
    <div class="ph-note">Call to discuss availability · 24/7</div>
    <hr>
    <form data-emergency class="ef-mini" name="mold-testing" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="mold-testing" /><p hidden aria-hidden="true"><label>Do not fill this out<input name="bot-field" /></label></p><div style="display:flex;flex-direction:column;gap:.9rem;">
      <div class="field"><label for="mold-testing-name">Your name</label><input type="text" name="name" required placeholder="Full name" id="mold-testing-name" autocomplete="name" aria-describedby="mold-testing-name-error"><span class="msg" id="mold-testing-name-error">Enter your name</span></div>
      <div class="field"><label for="mold-testing-phone">Phone</label><input type="tel" name="phone" required placeholder="(000) 000-0000" id="mold-testing-phone" autocomplete="tel" aria-describedby="mold-testing-phone-error"><span class="msg" id="mold-testing-phone-error">Enter a valid phone</span></div>
      <div class="field"><label for="mold-testing-service">What's going on?</label><select name="service" required id="mold-testing-service" aria-describedby="mold-testing-service-error"><option value="">Select…</option><option>Suspect hidden mold</option><option>Musty smell, can't see it</option><option>Post-remediation clearance</option><option>Real-estate inspection</option><option>Health concern at home</option></select><span class="msg" id="mold-testing-service-error">Choose one</span></div>
    </div>
    <button class="btn btn-alert btn-block mt-m" type="submit">Request callback</button>
    <p data-error role="alert" tabindex="-1" hidden style="color:#fff;margin-top:1rem;">We couldn't confirm receipt of your request. Please try again or <a href={`tel:${COMPANY.phoneRaw}`} style="color:#fff;text-decoration:underline;">call {COMPANY.phone}</a> for urgent help.</p>
    <div data-success role="status" tabindex="-1" style="display:none;text-align:center;padding:1rem 0;"><svg viewBox="0 0 24 24" fill="none" stroke="#46c37b" stroke-width="2" width="34" height="34" style="margin:0 auto .6rem;"><path d="M20 6L9 17l-5-5"/></svg><p style="color:#fff;font-weight:600;">Request received.</p><p style="color:#9db8ff;font-size:.9rem;">We'll call you shortly.</p></div>
    </form>
    <hr>
    <ul class="ef-list"><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Ask about insurance documentation</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Discuss the assessment scope and cost</li></ul>
  </div></aside>
</div></div></section>
<ServiceFacts />
<section class="pt pb"><div class="wrap-wide">
  <div class="sec-head reveal"><div><span class="eyebrow">01, What we handle</span><h2 class="h2 mt-s" style="max-width:20ch;">The right test for the right question.</h2></div><p class="body-l" style="max-width:32ch;">Testing should answer a specific question, not just generate a bill. We scope it to what you actually need.</p></div>
  <div class="types mt-l"><div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg><h3>Visual & moisture inspection</h3><p>A thorough walk-through with meters and thermal imaging.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3v6M7 9h10M8 9l-2 9a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l-2-9"/></svg><h3>Air-quality sampling</h3><p>Spore counts compared indoors vs. outdoors for context.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 7h6M9 11h6"/></svg><h3>Surface & swab sampling</h3><p>Targeted samples to identify what's growing where.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/></svg><h3>Laboratory analysis</h3><p>Confirm the laboratory, analytical methods and reporting included in the scope.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 6L9 17l-5-5"/><circle cx="12" cy="12" r="10"/></svg><h3>Post-remediation clearance</h3><p>Review against the agreed criteria, with the reviewer and scope confirmed beforehand.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg><h3>Real-estate & pre-purchase</h3><p>Discuss inspection limits and any concerns relevant to the property.</p></div></div>
</div></section>
<section class="pb"><div class="wrap-wide">
  <div class="sec-head reveal"><div><span class="eyebrow">02, The process</span><h2 class="h2 mt-s" style="max-width:18ch;">Agree on the question, scope and reporting.</h2></div></div>
  <div class="steps mt-l"><div class="step reveal"><div class="n">01 / Inspect</div><div><h3 class="h3">On-site inspection</h3><div class="sd"><p>The assessing professional reviews visible conditions, moisture concerns and inspection limits.</p><p>Discuss whether further investigation or sampling would be useful.</p></div></div></div>
      <div class="step reveal"><div class="n">02 / Sample</div><div><h3 class="h3">Take samples</h3><div class="sd"><p>Air and/or surface samples are collected where they'll actually be informative.</p><p>Ask why each proposed sample is useful.</p></div></div></div>
      <div class="step reveal"><div class="n">03 / Analyze</div><div><h3 class="h3">Lab analysis</h3><div class="sd"><p>Confirm the laboratory and the analysis included before booking.</p><p>Laboratory analysis and professional independence are separate questions.</p></div></div></div>
      <div class="step reveal"><div class="n">04 / Report</div><div><h3 class="h3">Clear report</h3><div class="sd"><p>You get plain-language findings, what was found, where, and what it means.</p><p>No jargon, no fear-mongering.</p></div></div></div>
      <div class="step reveal"><div class="n">05 / Recommend</div><div><h3 class="h3">Review next steps</h3><div class="sd"><p>Review findings, limitations and any recommended next steps with the assessing professional.</p><p>A sampling result does not determine an individual health risk.</p></div></div></div></div>
</div></section>
<section class="insight"><div class="wrap-wide"><div class="insight-in reveal">
  <span class="eyebrow nodash" style="color:#9db8ff;">How testing and removal fit together</span>
  <p class="h2" style="color:#fff;max-width:24ch;">Assessment and remediation <em>have different roles.</em></p>
  <p class="lead" style="color:#aac3ff;max-width:46ch;">Confirm who will assess the property, who would remediate it and who will review any work. Professional roles and the proposed scope should be clear before booking.</p>
  <a href="/restoration/mold-remediation/" class="link-arrow" style="color:#fff;">See mold remediation <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a>
</div></div></section>
<!-- EDITORIAL BODY (keywords del sheet) -->
<section class="pb">
  <div class="wrap-wide">
    <div class="insure-in reveal" style="align-items:start;">
      <div class="prose">
        <span class="eyebrow">Mold inspection and testing</span>
        <h2 class="h2 mt-s" style="max-width:24ch;">Understand what inspection and sampling can establish.</h2>
        <p><strong>Mold inspection</strong> should begin with the question that needs answering. Visible conditions, moisture concerns and access help determine whether further investigation is useful. A stain or a photo alone does not establish the species present or an individual health risk.</p>
        <p><strong>Mold testing</strong> is not automatically required for every concern. Ask which samples are proposed, why they are useful and how findings would change the plan. EPA explains that sampling is generally unnecessary when mold is visible; see its <a href="https://www.epa.gov/mold/samplingtesting-mold-necessary" target="_blank" rel="noopener">mold sampling guidance</a>.</p>
        <p>Confirm the assessor, laboratory, remediator and any post-remediation reviewer before booking. A laboratory report describes the samples analyzed and has limitations. Ask how results will be interpreted alongside site conditions, the agreed criteria and any work completed.</p>
      </div>
      <div>
        <div class="pullcard"><span class="num-label">What we handle</span><p style="font-family:var(--serif);font-weight:300;font-size:1.4rem;line-height:1.3;margin-top:.5rem;color:var(--ink);">Discuss inspection, any sampling and post-remediation review as clearly defined services.</p></div>
        <ul class="risk-list" style="margin-top:1rem;">
          <li><span class="risk-ico"><Icon name="inspect" size={18} /></span> Mold inspection & assessment</li>
          <li><span class="risk-ico"><Icon name="wave" size={18} /></span> Air & surface sampling</li>
          <li><span class="risk-ico"><Icon name="water" size={18} /></span> Moisture mapping</li>
          <li><span class="risk-ico"><Icon name="home" size={18} /></span> Post-remediation clearance</li>
        </ul>
      </div>
    </div>
  </div>
</section>
<ProjectExamples cities={["coral-springs", "doral", "naples"]} />
<InsuranceSupport />
<section class="pb"><div class="wrap-wide">
  <div class="sec-head reveal"><div><span class="eyebrow">04, Common questions</span><h2 class="h2 mt-s">Mold Testing & Inspection, answered.</h2></div></div>
  <ServiceFAQ items={SERVICE_FAQS["mold-testing"]} />
</div></section>
<section class="areas pt pb"><div class="wrap-wide reveal">
  <span class="eyebrow">Where we serve</span><h2 class="h2 mt-s" style="max-width:24ch;">Mold Testing & Inspection across South Florida.</h2>
  <div class="citylinks mt-m">{REGIONS.flatMap((r) => r.cities).map((c) => (<a href={`/service-areas/${c.slug}/`}>{c.name}</a>))}</div>
</div></section>
<section class="pb"><div class="wrap-wide">
  <div class="sec-head reveal"><div><span class="eyebrow">Related services</span><h2 class="h2 mt-s">Keep exploring</h2></div></div>
  <div class="rel-grid mt-l"><a href="/resources/mold-testing-cost/" class="rel"><div><span class="num-label">Cost guide</span><h3 style="margin-top:.3rem;">What affects mold testing cost?</h3></div><span aria-hidden="true">↗</span></a><a href="/restoration/mold-remediation/" class="rel reveal"><div><span class="num-label">Related service</span><h3 style="margin-top:.3rem;">Mold Remediation</h3></div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a>
      <a href="/resources/is-black-mold-dangerous/" class="rel reveal"><div><span class="num-label">Guide</span><h3 style="margin-top:.3rem;">Is black mold dangerous?</h3></div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a></div>
</div></section>
<section class="emcta"><div class="wrap-wide emcta-in reveal">
  <div><span class="eyebrow nodash" style="color:#ffd2c4;">Still unsure?</span><h2 class="display" style="color:#fff;max-width:16ch;">Get the facts before you spend.</h2></div>
  <div class="emcta-actions"><a href={`tel:${COMPANY.phoneRaw}`} class="btn btn-lg" style="background:#fff;color:var(--alert);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg> Call {COMPANY.phone}</a><a href="/emergency/" class="btn btn-lg btn-block" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5);">Request help online <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
</div></section>
</BaseLayout>
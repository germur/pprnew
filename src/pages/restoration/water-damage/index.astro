---
import LocalServiceLinks from "../../../components/LocalServiceLinks.astro";
import ProjectPhoto from "../../../components/ProjectPhoto.astro";
import { SERVICE_IMAGERY } from "../../../data/project-imagery";
import ServiceFAQ from "../../../components/ServiceFAQ.astro";
import InsuranceSupport from "../../../components/InsuranceSupport.astro";
import ServiceFacts from "../../../components/ServiceFacts.astro";
import { SERVICE_FAQS } from "../../../data/service-faqs";
import ProjectExamples from "../../../components/ProjectExamples.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { COMPANY , REGIONS } from "../../../data/company";
import Icon from "../../../components/Icon.astro";

const title = "Water Damage Restoration in South Florida | Paramount";
const description = "Water damage restoration information in South Florida. Discuss affected materials, extraction, drying, availability and project documentation. Contact us 24/7.";
---

<BaseLayout title={title} description={description} path="/restoration/water-damage/">
<!-- BREADCRUMB -->
<div class="wrap-wide">
  <nav class="crumb"><a href="/">Home</a><span>/</span><a href="/restoration/">Restoration</a><span>/</span> Water Damage</nav>
</div>

<!-- PILLAR HERO -->
<section class="phero">
  <div class="wrap-wide">
    <div class="phero-grid">
      <div class="reveal">
        <span class="eyebrow">Emergency Service · 24/7 · South Florida</span>
        <h1 class="h1 mt-s">Water Damage Restoration in South Florida</h1>
        <p class="empathy">Found water damage? Tell us what happened and discuss the next step.</p>
        <p class="lead maxw mt-m">Discuss the affected areas after leaks or flooding. <strong>The assessment defines the extraction, drying and restoration work proposed</strong>, along with access and documentation needs.</p>
        <div class="chips mt-m">
          <span class="chip">24/7 contact</span>
          <span class="chip">IICRC certified</span>
          <span class="chip">Project documentation</span>
          <span class="chip">24/7 · 365</span>
        </div>
        <ProjectPhoto selection={SERVICE_IMAGERY["water-damage"]} eager />
      </div>

      <aside class="reveal">
        <div class="emcard">
          <div class="eyebrow nodash" style="color:#9db8ff;">Emergency? Start here</div>
          <h3 class="mt-s">Talk to a certified crew now.</h3>
          <a href={`tel:${COMPANY.phoneRaw}`} class="phone">{COMPANY.phone}</a>
          <div class="ph-note">Call to discuss availability · 24/7</div>
          <hr>
          <form data-emergency class="ef-mini" name="water-damage" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="water-damage" /><p hidden aria-hidden="true"><label>Do not fill this out<input name="bot-field" /></label></p>
            <div style="display:flex;flex-direction:column;gap:.9rem;">
              <div class="field"><label for="water-damage-name">Your name</label><input type="text" name="name" required placeholder="Full name" id="water-damage-name" autocomplete="name" aria-describedby="water-damage-name-error"><span class="msg" id="water-damage-name-error">Enter your name</span></div>
              <div class="field"><label for="water-damage-phone">Phone</label><input type="tel" name="phone" required placeholder="(000) 000-0000" id="water-damage-phone" autocomplete="tel" aria-describedby="water-damage-phone-error"><span class="msg" id="water-damage-phone-error">Enter a valid phone</span></div>
              <div class="field"><label for="water-damage-service">What happened?</label><select name="service" required id="water-damage-service" aria-describedby="water-damage-service-error"><option value="">Select…</option><option>Burst / leaking pipe</option><option>Roof or ceiling leak</option><option>Flooding / storm water</option><option>Appliance overflow</option><option>Sewage backup</option></select><span class="msg" id="water-damage-service-error">Choose one</span></div>
            </div>
            <button class="btn btn-alert btn-block mt-m" type="submit">Request callback</button>
            <p data-error role="alert" tabindex="-1" hidden style="color:#fff;margin-top:1rem;">We couldn't confirm receipt of your request. Please try again or <a href={`tel:${COMPANY.phoneRaw}`} style="color:#fff;text-decoration:underline;">call {COMPANY.phone}</a> for urgent help.</p>
    <div data-success role="status" tabindex="-1" style="display:none;text-align:center;padding:1rem 0;">
              <svg viewBox="0 0 24 24" fill="none" stroke="#46c37b" stroke-width="2" width="34" height="34" style="margin:0 auto .6rem;"><path d="M20 6L9 17l-5-5"/></svg>
              <p style="color:#fff;font-weight:600;">Request received.</p>
              <p style="color:#9db8ff;font-size:.9rem;">A dispatcher will call within minutes.</p>
            </div>
          </form>
          <hr>
          <ul class="ef-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Ask about insurance documentation</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Discuss the assessment scope and cost</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- TRUST STRIP -->
<ServiceFacts />

<!-- WHAT WE HANDLE -->
<section class="pt pb">
  <div class="wrap-wide">
    <div class="sec-head reveal">
      <div><span class="eyebrow">01, What we handle</span><h2 class="h2 mt-s" style="max-width:20ch;">Assess the source and the affected materials.</h2></div>
      <p class="body-l" style="max-width:32ch;">The source, materials and site conditions determine the appropriate work. Confirm the proposed scope before authorizing it.</p>
    </div>
    <div class="types mt-l">
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2.5C8 7 6 10 6 13a6 6 0 0 0 12 0c0-3-2-6-6-10.5z"/></svg><h3>Burst &amp; leaking pipes</h3><p>Discuss the affected areas and responsibility for plumbing repairs and drying.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 11l9-7 9 7M5 10v10h14V10"/></svg><h3>Roof &amp; ceiling leaks</h3><p>Storm-driven and aging-roof intrusion that soaks insulation, drywall and framing.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 16c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2M2 20c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"/></svg><h3>Flooding &amp; storm water</h3><p>Hurricane surge, flash flooding and rising water across South Florida's low-lying zones.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 7h8M8 11h8"/></svg><h3>Appliance overflows</h3><p>Dishwashers, washing machines and HVAC condensate that quietly flood floors.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9h16v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM9 9V6a3 3 0 0 1 6 0v3"/></svg><h3>Sewage &amp; black water</h3><p>Discuss contamination concerns and the treatment, equipment and qualifications required.</p></div>
      <div class="type reveal"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><h3>Hidden moisture</h3><p>Behind walls and under floors, located with meters and thermal imaging.</p></div>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="pb">
  <div class="wrap-wide">
    <div class="sec-head reveal"><div><span class="eyebrow">02, The restoration process</span><h2 class="h2 mt-s" style="max-width:18ch;">A documented path from flooded to fully dry.</h2></div></div>
    <div class="steps mt-l">
      <div class="step reveal"><div class="n">01 / Inspect</div><div><h3 class="h3">Inspection &amp; moisture mapping</h3><div class="sd"><p>The assessment records accessible affected areas, moisture concerns and any further investigation needed.</p><p>Ask which photos and readings will be included in the project records.</p></div></div></div>
      <div class="step reveal"><div class="n">02 / Extract</div><div><h3 class="h3">Water extraction</h3><div class="sd"><p>Extraction methods depend on the water, access and affected materials identified in the assessment.</p><p>Discuss the work needed to limit further damage.</p></div></div></div>
      <div class="step reveal"><div class="n">03 / Dry</div><div><h3 class="h3">Structural drying &amp; dehumidification</h3><div class="sd"><p>Air movers and commercial dehumidifiers pull moisture from framing, subfloor and drywall.</p><p>Material condition determines whether drying or removal is appropriate.</p></div></div></div>
      <div class="step reveal"><div class="n">04 / Monitor</div><div><h3 class="h3">Moisture progress checks</h3><div class="sd"><p>The drying plan defines progress checks, equipment adjustments and review criteria.</p><p>Discuss unresolved moisture concerns and any additional work identified during review.</p></div></div></div>
      <div class="step reveal"><div class="n">05 / Restore</div><div><h3 class="h3">Repair &amp; restoration</h3><div class="sd"><p>Review the completed restoration scope and identify any additional repairs or specialist work needed.</p><p>Discuss progress readings, project records and any remaining responsibilities.</p></div></div></div>
    </div>
  </div>
</section>

<!-- CROSS-LINK water -> mold -->
<section class="insight">
  <div class="wrap-wide">
    <div class="insight-in reveal">
      <span class="eyebrow nodash" style="color:#9db8ff;">The most important thing to know</span>
      <p class="h2" style="color:#fff;max-width:24ch;">Untreated water becomes mold in <em>24 to 48 hours</em>.</p>
      <p class="lead" style="color:#aac3ff;max-width:46ch;">Florida's heat and humidity accelerate it. That's why our drying is verified to standard, and why we'll tell you honestly when a mold inspection is worth it.</p>
      <a href="/restoration/mold-remediation/" class="link-arrow" style="color:#fff;">Learn about professional mold remediation <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a>
    </div>
  </div>
</section>

<!-- EDITORIAL BODY (keywords del sheet: water extraction, flood, leak, ceiling, near me, 24/7) -->
<section class="pb">
  <div class="wrap-wide">
    <div class="insure-in reveal" style="align-items:start;">
      <div class="prose">
        <span class="eyebrow">Every kind of water loss</span>
        <h2 class="h2 mt-s" style="max-width:22ch;">From a slow leak to a full flood, handled fast.</h2>
        <p class="mt-m"><strong>Water damage restoration</strong> starts with understanding the affected areas, materials and moisture conditions. Tell us about the leak or flooding and whether the source is still active. An assessment helps define what can be dried, what may need removal and what work should be proposed.</p>
        <p><strong>Water extraction</strong> and structural drying may form part of the work, depending on the assessment. Progress readings help guide equipment adjustments and review the drying plan. Timing and material recovery depend on conditions; the proposed scope should explain those limits.</p>
        <p><strong>Flood damage restoration</strong> can involve contamination as well as moisture. Describe the source of the water and affected materials when you call. Discuss any cleaning, removal or specialist work identified in the assessment before authorizing the scope.</p>
        <p><strong>Ceiling water damage</strong> and moisture under flooring can require further investigation. The assessment should distinguish visible conditions from areas that have not been inspected. Ask how access, drying checks and any repairs outside the restoration scope will be handled.</p>
      </div>
      <div>
        <div class="pullcard"><span class="num-label">What we handle</span><p style="font-family:var(--serif);font-weight:300;font-size:1.4rem;line-height:1.3;margin-top:.5rem;color:var(--ink);">Every water loss, from a hidden leak to a full flood, dried to verified standard.</p></div>
        <ul class="risk-list" style="margin-top:1rem;">
          <li><span class="risk-ico"><Icon name="water" size={18} /></span> Emergency water extraction</li>
          <li><span class="risk-ico"><Icon name="wave" size={18} /></span> Flood damage restoration</li>
          <li><span class="risk-ico"><Icon name="inspect" size={18} /></span> Leak repair &amp; detection</li>
          <li><span class="risk-ico"><Icon name="home" size={18} /></span> Ceiling &amp; structural drying</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- PROOF -->
<ProjectExamples cities={["doral", "cape-coral", "naples"]} />

<!-- INSURANCE -->
<InsuranceSupport />

<!-- FAQ (densified content) -->
<section class="pb">
  <div class="wrap-wide">
    <div class="sec-head reveal"><div><span class="eyebrow">04, Common questions</span><h2 class="h2 mt-s">Water damage, answered.</h2></div></div>
    <ServiceFAQ items={SERVICE_FAQS["water-damage"]} />
</div></section>

<!-- SERVICE AREAS -->
<section class="areas pt pb">
  <div class="wrap-wide reveal">
    <span class="eyebrow">Where we serve</span>
    <h2 class="h2 mt-s" style="max-width:24ch;">Water damage restoration across South Florida.</h2>
    <div class="citylinks mt-m">{REGIONS.flatMap((r) => r.cities).map((c) => (<a href={`/service-areas/${c.slug}/`}>{c.name}</a>))}</div>
  </div>
</section>

<!-- RELATED -->
<section class="pb">
  <div class="wrap-wide">
    <div class="sec-head reveal"><div><span class="eyebrow">Related services</span><h2 class="h2 mt-s">Keep exploring</h2></div></div>
    <div class="rel-grid mt-l">
      <a href="/restoration/storm-damage/" class="rel reveal"><div><span class="num-label">Related service</span><h3 style="margin-top:.3rem;">Storm & Hurricane Damage</h3></div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a>
      <a href="/restoration/mold-remediation/" class="rel reveal"><div><span class="num-label">Related service</span><h3 style="margin-top:.3rem;">Mold Remediation</h3></div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a>
    </div>
  </div>
</section>

<!-- EMERGENCY CTA -->
<LocalServiceLinks heading="Water cleanup for your property" description="Read what information to share about the water source, affected materials and drying needs in these service areas." links={[{ href: "/service-areas/cooper-city/#flood-cleanup", label: "Cooper City flood cleanup" }, { href: "/service-areas/hobe-sound/#water-removal", label: "Hobe Sound water damage cleanup" }]} />
<section class="emcta">
  <div class="wrap-wide emcta-in reveal">
    <div>
      <span class="eyebrow nodash" style="color:#ffd2c4;">Don't let it spread</span>
      <h2 class="display" style="color:#fff;max-width:14ch;">Every hour of water costs you more.</h2>
    </div>
    <div class="emcta-actions">
      <a href={`tel:${COMPANY.phoneRaw}`} class="btn btn-lg" style="background:#fff;color:var(--alert);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg> Call {COMPANY.phone}</a>
      <a href="/emergency/" class="btn btn-lg btn-block" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5);">Request help online <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>
</BaseLayout>
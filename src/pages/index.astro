---
import BaseLayout from "../layouts/BaseLayout.astro";
import { COMPANY, REGIONS, CITY_COUNT } from "../data/company";
import Icon from "../components/Icon.astro";
import ProjectImage from "../components/ProjectImage.astro";
import { SERVICE_IMAGERY } from "../data/project-imagery";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/selected-projects.json";

const heroProject = projects.find(project => project.citySlug === "doral") || projects[0];
const title = "Paramount Restoration | Water, Fire, Mold & Storm, South Florida";
const description = "South Florida's 24/7 restoration company. Water damage, mold remediation, fire and storm restoration. IICRC-certified, fully insured, insurance handled.";
---

<BaseLayout title={title} description={description} path="/">
<!-- ============ HERO ============ -->
<section class="hero home-hero">
  <div class="wrap-wide home-hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Property restoration · 24/7 response</span>
      <h1 class="display">When damage happens,<br /><em>we help you move forward.</em></h1>
      <p class="lead mt-m">Get help with water, fire, mold and storm damage. Our IICRC-certified team assesses the loss, documents the work and helps you take the next step.</p>
      <div class="cta-row mt-m">
        <a href={`tel:${COMPANY.phoneRaw}`} class="btn btn-primary btn-lg">Call {COMPANY.phone} <span aria-hidden="true">↗</span></a>
        <a href="/emergency/" class="btn btn-ghost btn-lg">Request help online</a>
      </div>
      <div class="home-trust"><span>24/7 emergency response</span><span>IICRC certified</span><span>Insurance documentation</span></div>
      <nav class="hero-quicklinks" aria-label="Find your restoration service"><a href="/restoration/water-damage/">Water damage ↗</a><a href="/restoration/mold-remediation/">Mold ↗</a><a href="/restoration/fire-damage/">Fire &amp; smoke ↗</a><a href="/restoration/storm-damage/">Storm ↗</a></nav>
    </div>
    <figure class="home-hero-photo">
      <img src={heroProject.photos[0].thumbnail} srcset={heroProject.photos[0].thumbnail !== heroProject.photos[0].src ? `${heroProject.photos[0].thumbnail} ${heroProject.photos[0].thumbnailWidth}w, ${heroProject.photos[0].src} ${heroProject.photos[0].width}w` : undefined} sizes="(max-width:820px) 100vw, 45vw" alt={heroProject.photos[0].alt} width={heroProject.photos[0].width} height={heroProject.photos[0].height} loading="eager" fetchpriority="high" decoding="async" />
      <figcaption><span>On site · {heroProject.city}, FL</span><a href={`/projects/#${heroProject.id}`}>See this project <span aria-hidden="true">↗</span></a></figcaption>
    </figure>
  </div>
</section>

<!-- ============ TRUST STRIP ============ -->
<section class="trust">
  <div class="wrap-wide">
    <div class="trust-grid">
      <div class="trust-item reveal"><span class="trust-ico"><Icon name="doc" size={22} /></span><span class="num-label">Insurance</span><p>We bill your carrier directly and document every step for the claim.</p></div>
      <div class="trust-item reveal"><span class="trust-ico"><Icon name="badge" size={22} /></span><span class="num-label">Certification</span><p>IICRC-certified technicians in water, fire, mold &amp; applied structural drying.</p></div>
      <div class="trust-item reveal"><span class="trust-ico"><Icon name="shield" size={22} /></span><span class="num-label">Coverage</span><p>Fully insured &amp; bonded. Ask our team about credentials and the scope of your project.</p></div>
      <div class="trust-item reveal"><span class="trust-ico"><Icon name="check" size={22} /></span><span class="num-label">Local</span><p>Real crews based in South Florida, documenting every loss for your insurer.</p></div>
    </div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="pt pb" id="services">
  <div class="wrap-wide">
    <div class="sec-head reveal">
      <div>
        <span class="eyebrow">01 · What we restore</span>
        <h2 class="h2 mt-s" style="max-width:18ch;">The right help for your property.</h2>
      </div>
      <p class="body-l" style="max-width:34ch;">Start with the damage you see. Each service explains what we assess, how the work proceeds and how to request help.</p>
    </div>

    <div class="svc-grid mt-l">
      <a href="/restoration/water-damage/" class="svc reveal">
        <div class="svc-media"><ProjectImage class="svc-bg" image={SERVICE_IMAGERY["water-damage"].photo} position={SERVICE_IMAGERY["water-damage"].position} sizes="(max-width:540px) 100vw, (max-width:1100px) 50vw, 25vw" /><span class="svc-photo-note">Project photo · {SERVICE_IMAGERY["water-damage"].project.city}</span><span class="svc-icon"><Icon name="water" size={26} /></span></div>
        <div class="svc-body">
          <div class="svc-top"><span class="num-label">Water &amp; moisture</span></div>
          <h3 class="h3">Water Damage Restoration</h3>
          <p>Burst pipes, roof leaks, flooding. We extract, dry and restore, then stop the mold that follows.</p>
          <span class="link-arrow">Explore water damage <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></span>
        </div>
      </a>
      <a href="/restoration/mold-remediation/" class="svc reveal">
        <div class="svc-media"><ProjectImage class="svc-bg" image={SERVICE_IMAGERY["mold-remediation"].photo} position={SERVICE_IMAGERY["mold-remediation"].position} sizes="(max-width:540px) 100vw, (max-width:1100px) 50vw, 25vw" /><span class="svc-photo-note">Project photo · {SERVICE_IMAGERY["mold-remediation"].project.city}</span><span class="svc-icon"><Icon name="mold" size={26} /></span></div>
        <div class="svc-body">
          <div class="svc-top"><span class="num-label">Mold &amp; containment</span></div>
          <h3 class="h3">Mold Remediation</h3>
          <p>Containment, HEPA filtration, removal and third-party clearance. Built for Florida humidity.</p>
          <span class="link-arrow">Explore mold remediation <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></span>
        </div>
      </a>
      <a href="/restoration/fire-damage/" class="svc reveal">
        <div class="svc-media"><ProjectImage class="svc-bg" image={SERVICE_IMAGERY["fire-damage"].photo} position={SERVICE_IMAGERY["fire-damage"].position} sizes="(max-width:540px) 100vw, (max-width:1100px) 50vw, 25vw" /><span class="svc-photo-note">Project photo · {SERVICE_IMAGERY["fire-damage"].project.city}</span><span class="svc-icon"><Icon name="fire" size={26} /></span></div>
        <div class="svc-body">
          <div class="svc-top"><span class="num-label">Fire &amp; smoke</span></div>
          <h3 class="h3">Fire &amp; Smoke Damage</h3>
          <p>Soot and smoke removal, odor neutralization and contents recovery, plus the water from firefighting.</p>
          <span class="link-arrow">Explore fire damage <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></span>
        </div>
      </a>
      <a href="/restoration/storm-damage/" class="svc reveal">
        <div class="svc-media"><ProjectImage class="svc-bg" image={SERVICE_IMAGERY["storm-damage"].photo} position={SERVICE_IMAGERY["storm-damage"].position} sizes="(max-width:540px) 100vw, (max-width:1100px) 50vw, 25vw" /><span class="svc-photo-note">Project photo · {SERVICE_IMAGERY["storm-damage"].project.city}</span><span class="svc-icon"><Icon name="storm" size={26} /></span></div>
        <div class="svc-body">
          <div class="svc-top"><span class="num-label">Storm &amp; hurricane</span></div>
          <h3 class="h3">Storm &amp; Hurricane Damage</h3>
          <p>Emergency tarping, water intrusion, debris and full structural restoration after the season's worst.</p>
          <span class="link-arrow">Explore storm damage <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></span>
        </div>
      </a>
    </div>

    <div class="svc-row mt-m">
      <a href="/restoration/mold-testing/" class="svc-mini reveal">
        <span class="svc-mini-ico"><Icon name="testing" size={24} /></span>
        <div><span class="num-label">Inspection &amp; testing</span><h3 class="h3" style="margin-top:.3rem;">Mold Testing &amp; Inspection</h3></div>
        <p>Independent inspection and lab analysis, before you commit to remediation.</p>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
      </a>
      <a href="/commercial/" class="svc-mini reveal">
        <span class="svc-mini-ico"><Icon name="commercial" size={24} /></span>
        <div><span class="num-label">Commercial properties</span><h3 class="h3" style="margin-top:.3rem;">Commercial Restoration</h3></div>
        <p>Large-loss response for property managers, HOAs and businesses.</p>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ============ CROSS-LINK INSIGHT ============ -->
<section class="insight">
  <div class="wrap-wide">
    <div class="insight-in reveal">
      <span class="eyebrow nodash" style="color:#9db8ff;">The connection most companies miss</span>
      <p class="h2" style="color:#fff;max-width:24ch;">Wet materials need attention. <em>Don't wait</em> for visible mold.</p>
      <p class="lead" style="color:#aac3ff;max-width:46ch;">That's why we don't just dry your property. We monitor moisture to clearance standards and tell you, honestly, whether testing is warranted. One emergency, handled to the end.</p>
      <a href="/restoration/mold-remediation/" class="link-arrow" style="color:#fff;">See how water leads to mold <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a>
    </div>
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section class="pt pb" id="process">
  <div class="wrap-wide">
    <div class="sec-head reveal">
      <div><span class="eyebrow">02 · How it works</span><h2 class="h2 mt-s" style="max-width:16ch;">A clear path from damage to recovery.</h2></div>
    </div>
    <div class="proc-grid mt-l">
      <div class="proc reveal"><div class="proc-no">01</div><h3 class="h3">Call &amp; dispatch</h3><p>One call, day or night. We dispatch the nearest certified crew immediately.</p></div>
      <div class="proc reveal"><div class="proc-no">02</div><h3 class="h3">Assess &amp; document</h3><p>We inspect, photograph and scope the damage, building the file your insurer needs.</p></div>
      <div class="proc reveal"><div class="proc-no">03</div><h3 class="h3">Mitigate &amp; dry</h3><p>Extraction, containment and structural drying to stop the damage from spreading.</p></div>
      <div class="proc reveal"><div class="proc-no">04</div><h3 class="h3">Restore &amp; verify</h3><p>We restore to pre-loss condition and verify to clearance standards before we leave.</p></div>
    </div>
  </div>
</section>

<!-- ============ PROJECTS ============ -->
<section class="pt pb work-home">
  <div class="wrap-wide">
    <div class="sec-head"><div><span class="eyebrow">03 · In the field</span><h2 class="h2 mt-s" style="max-width:22ch;">A closer look at <em>the work.</em></h2></div><a href="/projects/" class="link-arrow">View all {projects.length} projects <span aria-hidden="true">↗</span></a></div>
    <p class="body-l mt-m" style="max-width:56ch;">Real project photos, from affected materials to inspection readings. Explore the details behind each visit.</p>
    <div class="work-grid mt-l">{projects.slice(0,6).map(project => <ProjectCard project={project} compact />)}</div>
  </div>
</section>

<!-- ============ SERVICE AREAS ============ -->
<section class="areas pt pb">
  <div class="wrap-wide">
    <div class="sec-head reveal">
      <div><span class="eyebrow">04 · Where we work</span><h2 class="h2 mt-s" style="max-width:20ch;">{CITY_COUNT} Florida cities. <em>Real</em> local crews.</h2></div>
      <p class="body-l" style="max-width:34ch;">Find your city and learn about local service coverage. Call us to confirm availability for your property and type of damage.</p>
    </div>
    <div class="areas-grid mt-l reveal">
      {REGIONS.map((region) => (
        <div class="area-col">
          <h4 class="num-label">{region.name}</h4>
          <ul>
            {region.cities.map((city) => (
              <li>
                <a href={`/service-areas/${city.slug}/`} class={city.slug === "miami" ? "city-feat" : undefined}>
                  {city.name}{city.slug === "miami" ? " →" : ""}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ INSURANCE BAND ============ -->
<section class="insure pb">
  <div class="wrap-wide">
    <div class="insure-in reveal">
      <div>
        <span class="eyebrow">Insurance, handled</span>
        <h2 class="h2 mt-s" style="max-width:18ch;">We speak your insurer's language, so you don't have to.</h2>
        <p class="lead maxw mt-m">From the first photo to the final invoice, we document the loss and bill your carrier directly. You focus on your family; we handle the claim.</p>
        <a href="/insurance-claims/" class="btn btn-blue btn-lg mt-m">How we support your claim <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <ul class="insure-list">
        <li><span class="num-label">01</span> Direct insurance billing &amp; carrier coordination</li>
        <li><span class="num-label">02</span> Photo &amp; moisture documentation for every claim</li>
        <li><span class="num-label">03</span> Detailed scope &amp; line-item estimates</li>
        <li><span class="num-label">04</span> Fully insured &amp; bonded, credentials on request</li>
      </ul>
    </div>
  </div>
</section>

<!-- ============ RESOURCES TEASER ============ -->
<section class="pb">
  <div class="wrap-wide">
    <div class="sec-head reveal">
      <div><span class="eyebrow">05 · Resources</span><h2 class="h2 mt-s" style="max-width:18ch;">Answers before the emergency.</h2></div>
      <a href="/resources/" class="link-arrow">Explore resources <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg></a>
    </div>
    <div class="res-grid mt-l">
      <a href="/resources/is-black-mold-dangerous/" class="res reveal"><span class="num-label">Mold guide</span><h3 class="h3">Is black mold dangerous?</h3><p>What's true, what's hype, and when to call a professional.</p></a>
      <a href="/restoration/water-damage/" class="res reveal"><span class="num-label">Water damage</span><h3 class="h3">Water damage restoration</h3><p>Understand extraction, drying and the next steps for your property.</p></a>
      <a href="/restoration/storm-damage/" class="res reveal"><span class="num-label">Storm damage</span><h3 class="h3">Storm recovery services</h3><p>Explore help with water intrusion, affected materials and storm damage.</p></a>
    </div>
  </div>
</section>

<!-- ============ EMERGENCY CTA ============ -->
<section class="emcta">
  <div class="wrap-wide emcta-in reveal">
    <div>
      <span class="eyebrow nodash" style="color:#ffd2c4;">24/7 Emergency Response</span>
      <h2 class="display" style="color:#fff;max-width:16ch;">You don’t have to handle this alone.</h2>
      <p class="lead mt-m" style="color:#ffd9cd;max-width:42ch;">Don't wait for the damage to spread. Call now or send a request, and a certified crew is on the way.</p>
    </div>
    <div class="emcta-actions">
      <a href={`tel:${COMPANY.phoneRaw}`} class="btn btn-lg" style="background:#fff;color:var(--alert);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg> Call {COMPANY.phone}</a>
      <a href="/emergency/" class="btn btn-lg btn-block" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5);">Request help online <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>
</BaseLayout>

<style>
.areas-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.svc-photo-note{position:absolute;bottom:10px;left:12px;z-index:2;border:1px solid #ffffffa0;border-radius:6px;background:#ffffffed;padding:5px 7px;font-size:.62rem;color:var(--ink);font-weight:500;max-width:calc(100% - 24px)}
@media(max-width:900px){.areas-grid{grid-template-columns:1fr 1fr}}@media(max-width:540px){.areas-grid{gap:2rem 1rem}}
</style>

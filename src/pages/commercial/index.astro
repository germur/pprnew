---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { COMPANY, CITY_COUNT } from "../../data/company";
import ProjectPhoto from "../../components/ProjectPhoto.astro";
import { SERVICE_IMAGERY } from "../../data/project-imagery";
import InsuranceSupport from "../../components/InsuranceSupport.astro";
import ProcessOverview from "../../components/ProcessOverview.astro";
import ServiceFacts from "../../components/ServiceFacts.astro";
---
<BaseLayout title="Commercial Restoration in Florida | Paramount" description="Discuss commercial property restoration after water, fire, mold or storm damage. Confirm site access, availability, scope and project documentation. Contact us 24/7." path="/commercial/">
<div class="wrap-wide"><nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Commercial Restoration</span></nav></div>
<section class="phero"><div class="wrap-wide"><div class="phero-grid"><div>
<span class="eyebrow">Commercial properties · 24/7 contact</span><h1 class="h1 mt-s">A clear restoration plan for your property.</h1>
<p class="lead mt-m">For property managers, HOAs and businesses dealing with water, fire, mold or storm damage. Share the affected areas, access requirements and operational priorities so we can discuss the next step.</p>
<div class="cta-row mt-m"><a class="btn btn-primary" href={`tel:${COMPANY.phoneRaw}`}>Call {COMPANY.phone}</a><a class="btn btn-ghost" href="/contact/">Discuss your property</a></div>
<ProjectPhoto selection={SERVICE_IMAGERY.commercial} eager />
</div><aside><div class="emcard"><span class="eyebrow nodash" style="color:#b8d0ff">Before work begins</span><h2 class="h3 mt-s">Confirm the scope and the people involved.</h2><p class="sub mt-m">Discuss who can authorize work, how the site is accessed and what needs to remain operational. Availability, scheduling and any specialist work must be confirmed for your property.</p><ul class="ef-list"><li>Property address and site contact</li><li>Areas affected and access restrictions</li><li>Proposed work, cost and responsibilities</li><li>Documentation and communication needs</li></ul><a class="btn btn-blue btn-block mt-m" href="/contact/">Ask about your property</a></div></aside></div></div></section>
<ServiceFacts />
<section class="pt pb"><div class="wrap-wide"><span class="eyebrow">Property needs</span><h2 class="h2 mt-s">Plan around the building and the people using it.</h2><div class="types mt-l"><div class="type"><h3>Property managers</h3><p>Identify site contacts, authorization requirements and access for the proposed work.</p></div><div class="type"><h3>HOAs and shared buildings</h3><p>Discuss affected units, shared areas and communication with owners or residents.</p></div><div class="type"><h3>Businesses</h3><p>Explain occupied areas, working hours and any operational constraints before scheduling.</p></div><div class="type"><h3>Specialist work</h3><p>Confirm responsibilities for structural repairs, utilities, roofing and any other work outside the agreed restoration scope.</p></div></div></div></section>
<section class="pb"><div class="wrap-wide"><span class="eyebrow">Restoration services</span><h2 class="h2 mt-s">Start with the damage you see.</h2><div class="res-grid mt-l"><a class="res" href="/restoration/water-damage/"><h3 class="h3">Water damage</h3><p>Discuss affected materials, extraction and drying.</p></a><a class="res" href="/restoration/fire-damage/"><h3 class="h3">Fire and smoke</h3><p>Assess affected surfaces, contents and any water from firefighting.</p></a><a class="res" href="/restoration/mold-remediation/"><h3 class="h3">Mold concerns</h3><p>Confirm assessment, remediation and review roles before work.</p></a><a class="res" href="/restoration/storm-damage/"><h3 class="h3">Storm damage</h3><p>Discuss safe access, temporary protection and water intrusion.</p></a></div></div></section>
<section class="pb"><div class="wrap-wide"><span class="eyebrow">How it works</span><h2 class="h2 mt-s">From the first conversation to project review.</h2><ProcessOverview /></div></section>
<InsuranceSupport />
<section class="insight"><div class="wrap-wide"><div class="insight-in"><span class="eyebrow nodash" style="color:#b8d0ff">Before the next loss</span><h2 class="h2" style="color:#fff">Prepare your property information.</h2><p class="lead" style="color:#d4e2fa">Keep site contacts, access details and existing condition records available. Discuss any proposed service arrangement, fees and availability before relying on it for an emergency.</p><a class="btn btn-ghost" href="/contact/">Discuss a response plan</a></div></div></section>
<section class="pt pb"><div class="wrap-wide"><h2 class="h2">Find your property location.</h2><p class="lead mt-m">Our directory lists {CITY_COUNT} Florida cities. Call to confirm availability for your location and the type of damage.</p><a class="btn btn-primary mt-m" href="/service-areas/">Search service areas</a></div></section>
</BaseLayout>

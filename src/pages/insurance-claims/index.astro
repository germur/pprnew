---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { COMPANY } from "../../data/company";
import ServiceFAQ from "../../components/ServiceFAQ.astro";
import { INSURANCE_ANSWER } from "../../data/service-faqs";
const questions = [
 { question: 'Does contacting Paramount open an insurance claim?', answer: 'No. Contacting us is a request to discuss restoration help. Ask your insurer or agent how to report the loss and obtain a claim number. Our restoration records can support your discussion with them.' },
 { question: 'Is the restoration work covered?', answer: INSURANCE_ANSWER },
 { question: 'Will I only need to pay my deductible?', answer: 'That cannot be assumed. Your responsibilities depend on the policy, coverage decision, agreed work and payment terms. Confirm any deductible, uncovered work and other amounts before authorizing the scope.' },
 { question: 'Can you guarantee approval or a payment amount?', answer: 'No. The insurer determines coverage and claim payment. Photos, readings and a written scope describe the restoration work; they do not guarantee approval or resolve a coverage dispute.' },
];
---
<BaseLayout title="Insurance Documentation for Restoration | Paramount" description="Understand restoration photos, readings, scopes and project records for your insurer. Confirm coverage, billing arrangements and payment responsibilities before work." path="/insurance-claims/">
<div class="wrap-wide"><nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Insurance Documentation</span></nav></div>
<section class="phero"><div class="wrap-wide"><div class="phero-grid"><div><span class="eyebrow">Insurance documentation</span><h1 class="h1 mt-s">Clear project records for your insurer.</h1><p class="lead mt-m">Photos, relevant readings and a written scope help explain the damage and the proposed restoration work. We can discuss the records available for your project and the information your insurer requests.</p><p class="body-l mt-m">Your insurer reviews coverage and payment. Confirm the agreed work, billing arrangements and any amount you may owe before authorizing work.</p><div class="cta-row mt-m"><a class="btn btn-primary" href="/contact/">Discuss project documentation</a><a class="btn btn-ghost" href={`tel:${COMPANY.phoneRaw}`}>Call {COMPANY.phone}</a></div></div><aside><div class="emcard"><span class="eyebrow nodash" style="color:#b8d0ff">Useful information</span><h2 class="h3 mt-s">Have these details available.</h2><ul class="ef-list mt-m"><li>Your property location and contact details</li><li>When you noticed the damage</li><li>Photos or records you already have</li><li>Your insurer and claim number, if available</li></ul><p class="sub mt-m">You can contact us to discuss restoration before you have every detail. Reporting a claim to your insurer is a separate step.</p></div></aside></div></div></section>
<section class="pt pb"><div class="wrap-wide"><span class="eyebrow">Our role</span><h2 class="h2 mt-s">Document the work. Keep responsibilities clear.</h2><div class="proc-grid mt-l"><div class="proc"><div class="proc-no">01</div><h3 class="h3">Record conditions</h3><p>Discuss photos, observed damage and readings relevant to the assessment.</p></div><div class="proc"><div class="proc-no">02</div><h3 class="h3">Agree the scope</h3><p>Review the proposed restoration, estimate, access requirements and work exclusions.</p></div><div class="proc"><div class="proc-no">03</div><h3 class="h3">Track the work</h3><p>Ask how progress and any changes to the agreed scope will be documented.</p></div><div class="proc"><div class="proc-no">04</div><h3 class="h3">Review the records</h3><p>Keep the agreed scope, work records and invoices for your own records and insurer.</p></div></div></div></section>
<section class="insure pb"><div class="wrap-wide"><div class="insure-in"><div><span class="eyebrow">Before authorizing work</span><h2 class="h2 mt-s">Understand the scope and payment terms.</h2><p class="lead mt-m">Ask which work is proposed, what is excluded and how additional work would be approved. Discuss direct billing only as an arrangement to be confirmed for your project.</p><a class="link-arrow mt-m" href="/our-process/">What to expect during restoration →</a></div><ul class="insure-list"><li><span class="num-label">01</span> Written scope and estimate</li><li><span class="num-label">02</span> Coverage questions for your insurer</li><li><span class="num-label">03</span> Billing and payment responsibilities</li><li><span class="num-label">04</span> Approval process for scope changes</li></ul></div></div></section>
<section class="pb"><div class="wrap-wide"><span class="eyebrow">Common questions</span><h2 class="h2 mt-s">Restoration records and your claim.</h2><ServiceFAQ items={questions} /><p class="small mt-m">For general background, see <a href="https://content.naic.org/consumer/homeowners-insurance.htm" target="_blank" rel="noopener">NAIC homeowners insurance information</a>. Discuss your own policy and claim with your insurer or agent.</p></div></section>
<section class="emcta"><div class="wrap-wide emcta-in"><div><span class="eyebrow nodash" style="color:#dce6ff">Need restoration help?</span><h2 class="display" style="color:#fff">Let's discuss the next step.</h2></div><div class="emcta-actions"><a class="btn btn-ghost btn-lg" href={`tel:${COMPANY.phoneRaw}`}>Call {COMPANY.phone}</a><a class="btn btn-ghost btn-lg" href="/contact/">Contact our team</a></div></div></section>
</BaseLayout>

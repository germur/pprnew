---
import { RESTORATION_STEPS } from "../../data/restoration-process";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { COMPANY } from "../../data/company";
import Icon from "../../components/Icon.astro";
import projects from "../../data/selected-projects.json";
const project = projects.find(p => p.citySlug === "doral")!;
const photo = project.photos[0];
const steps = RESTORATION_STEPS;
---
<BaseLayout title="Our Restoration Process | What to Expect | Paramount" description="Know what to expect: first contact, damage assessment, stabilization, treatment and project review. Explore Paramount's property restoration process in Florida." path="/our-process/">
<div class="wrap-wide"><nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Our Process</span></nav></div>
<section class="process-hero">
  <div class="wrap-wide process-hero-grid">
    <div class="process-hero-copy"><span class="eyebrow">The next step, made clear</span><h1>Property damage is stressful.<br /><em>The process should be clear.</em></h1><p class="lead">From the first conversation to the final review, know what to expect, what we document and what to ask along the way.</p><div class="cta-row"><a class="btn btn-primary" href="#restoration-steps">See the five steps <span aria-hidden="true">↓</span></a><a class="process-phone" href={`tel:${COMPANY.phoneRaw}`}><Icon name="phone" size={18} />{COMPANY.phone}</a></div><p class="process-hero-note">Water · Fire · Mold · Storm</p></div>
    <figure class="process-photo"><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} fetchpriority="high" /><figcaption><span><strong>Documenting conditions</strong>Moisture checks · Doral, FL</span><a href={`/projects/#${project.id}`}>View project <span aria-hidden="true">↗</span></a></figcaption></figure>
  </div>
</section>
<div class="process-principles"><div class="wrap-wide"><div><Icon name="clock" /><span><strong>24/7 contact</strong>Start with a conversation</span></div><div><Icon name="doc" /><span><strong>Documented conditions</strong>Photos and project records</span></div><div><Icon name="badge" /><span><strong>IICRC Certified</strong>Restoration expertise</span></div></div></div>
<section class="pt pb" id="restoration-steps">
  <div class="wrap-wide process-layout">
    <aside class="process-guide"><span class="eyebrow">What to expect</span><h2 class="h2">Five steps.<br />One informed customer.</h2><p>Every loss is different. The scope, order and timing are adapted to your property, the damage and access conditions.</p><nav aria-label="Restoration steps">{steps.map((step,i) => <a href={`#process-step-${i+1}`}><span>0{i+1}</span>{step.label}<span aria-hidden="true">↗</span></a>)}</nav><a class="process-guide-link" href="/restoration/">Explore restoration services <span aria-hidden="true">→</span></a></aside>
    <ol class="process-timeline">{steps.map((step,i) => <li id={`process-step-${i+1}`}><div class="process-step-marker" aria-hidden="true">0{i+1}</div><article class="process-step-card"><div class="process-step-top"><span>{step.label}</span><Icon name={step.icon} size={25} /></div><h3>{step.title}</h3><p>{step.text}</p><div class="process-outcome"><Icon name="check" size={18} /><span>{step.outcome}</span></div><p class="process-step-note">{step.note}</p></article></li>)}</ol>
  </div>
</section>
<section class="process-prepare" id="first-call"><div class="wrap-wide process-prepare-grid"><div><span class="eyebrow">Your first conversation</span><h2 class="h2">You don't need all the answers to call.</h2><p>Start with what you know. These details help us understand the situation and discuss the next step.</p><a class="btn btn-primary" href={`tel:${COMPANY.phoneRaw}`}><Icon name="phone" size={18} />Talk to our team</a></div><ul><li><span aria-hidden="true">01</span><div><h3>The property location</h3><p>Your city and address, plus any access restrictions.</p></div></li><li><span aria-hidden="true">02</span><div><h3>What you can see</h3><p>The type of damage, affected areas and when you noticed it.</p></div></li><li><span aria-hidden="true">03</span><div><h3>Your contact and claim details</h3><p>A way to reach you and claim information, if you already have it.</p></div></li></ul></div></section>
<section class="pt pb"><div class="wrap-wide process-faq-grid"><div><span class="eyebrow">Before work begins</span><h2 class="h2 mt-s">Good questions.<br />Clear expectations.</h2><p class="mt-m">Ask about the proposed scope, documentation and communication before work starts.</p><a class="process-guide-link" href="/contact/">Ask us about your property <span aria-hidden="true">→</span></a></div><div class="faq"><details><summary>How long does restoration take?</summary><p>Timing depends on the type and extent of damage, affected materials, access and the agreed scope. Drying and treatment decisions depend on conditions and progress checks. Ask for an estimated schedule after the assessment and updates as work proceeds.</p></details><details><summary>Is every job a water-damage dry-out?</summary><p>No. Water, fire, mold and storm damage require different work. These five steps explain the overall customer experience; your property assessment determines the treatment and documentation needed.</p></details><details><summary>Can you help with project documentation for insurance?</summary><p>We can discuss photos, readings and project records relevant to the restoration work. Your insurer determines coverage and claim decisions. Visit our insurance claims page to learn more about the documentation process.</p><a class="process-guide-link" href="/insurance-claims/">Insurance claim support →</a></details><details><summary>Where can I see examples of your work?</summary><p>Our project gallery includes documented property conditions, moisture checks and equipment from visits across Florida.</p><a class="process-guide-link" href="/projects/">Browse project photos →</a></details></div></div></section>
<section class="process-next"><div class="wrap-wide"><div><span class="eyebrow">Start here</span><h2 class="h2">Let's work out your next step.</h2><p>Tell us where you need help and what happened.</p></div><div class="process-next-actions"><a class="btn btn-primary" href={`tel:${COMPANY.phoneRaw}`}>Call {COMPANY.phone}</a><a class="btn btn-ghost" href="/emergency/">Request help online <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
<style>
.process-hero{padding:2rem 0 4rem;background:radial-gradient(ellipse at 10% 20%,#e9f0ff,transparent 65%)}.process-hero-grid{display:grid;grid-template-columns:1.13fr 1fr;gap:clamp(2rem,5vw,5rem);align-items:center}.process-hero h1{font-size:clamp(2.5rem,4.3vw,4.3rem);line-height:1.08;font-weight:600;letter-spacing:-.05em;margin:1.4rem 0;max-width:18ch;text-wrap:balance}.process-hero h1 em{font-style:normal;color:var(--blue)}.process-hero .lead{max-width:47ch;font-size:1.1rem}.process-hero .cta-row{margin-top:1.8rem;gap:1.3rem;align-items:center}.process-phone{display:inline-flex;align-items:center;gap:8px;font-size:.9rem;font-weight:600;min-height:44px}.process-phone:hover{color:var(--blue)}.process-hero-note{font-size:.75rem;margin-top:1.5rem;color:var(--ink-2)}
.process-photo{border-radius:22px;overflow:hidden;border:1px solid var(--line);background:#fff;box-shadow:0 20px 50px -30px #11284060;transform:rotate(1deg)}.process-photo img{width:100%;height:350px;object-fit:cover}.process-photo figcaption{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.2rem;font-size:.75rem;color:var(--ink-2)}.process-photo strong{display:block;font-weight:600;font-size:.9rem;color:var(--ink);margin-bottom:.3rem}.process-photo a{color:var(--blue);font-weight:600;min-height:44px;display:flex;align-items:center;gap:6px;white-space:nowrap}
.process-principles{background:#fff;border-block:1px solid var(--line)}.process-principles>.wrap-wide{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;padding-block:1.7rem}.process-principles>.wrap-wide>div{display:flex;gap:14px;align-items:center}.process-principles svg{color:var(--blue);flex-shrink:0}.process-principles span{font-size:.8rem;color:var(--ink-2);line-height:1.5}.process-principles strong{display:block;color:var(--ink);font-weight:600;font-size:.9rem;margin-bottom:.2rem}
.process-layout{display:grid;grid-template-columns:.8fr 1.4fr;gap:clamp(2rem,6vw,6rem);align-items:start}.process-guide{position:sticky;top:120px}.process-guide h2{font-size:clamp(1.9rem,3vw,2.7rem);margin-top:1rem}.process-guide>p{margin-top:1.3rem;color:var(--ink-2);font-size:.95rem;line-height:1.7;max-width:38ch}.process-guide nav{margin-top:1.5rem;max-width:350px}.process-guide nav a{display:flex;align-items:center;gap:14px;border-bottom:1px solid var(--line);min-height:48px;padding:10px 0;font-size:.85rem;font-weight:500}.process-guide nav a>span:first-child{font-size:.7rem;color:var(--blue)}.process-guide nav a>span:last-child{margin-left:auto;color:var(--ink-2)}.process-guide nav a:hover{color:var(--blue)}.process-guide-link{display:inline-block;margin-top:1.4rem;padding-block:8px;color:var(--blue);font-size:.85rem;font-weight:600}
.process-timeline{list-style:none;margin:0;padding:0}.process-timeline>li{display:grid;grid-template-columns:44px minmax(0,1fr);gap:18px;position:relative;padding-bottom:22px;align-items:start}.process-timeline>li:not(:last-child)::before{content:'';position:absolute;left:21px;top:44px;bottom:0;width:1px;background:#c3d1e9}.process-step-marker{display:grid;place-items:center;width:44px;height:44px;border:1px solid #c3d1e9;border-radius:50%;color:var(--blue);font-weight:600;font-size:.85rem;background:var(--paper)}.process-step-card{border:1px solid var(--line);border-radius:18px;padding:clamp(1.4rem,3vw,2rem);background:#fff}.process-step-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:var(--blue);font-size:.73rem;letter-spacing:.06em;text-transform:uppercase;font-weight:600;margin-bottom:1.3rem}.process-step-card h3{font-size:clamp(1.35rem,2.1vw,1.8rem);line-height:1.2;letter-spacing:-.035em;font-weight:600;max-width:25ch}.process-step-card>p{color:var(--ink-2);font-size:.94rem;line-height:1.75;margin-top:1rem}.process-outcome{display:flex;align-items:flex-start;gap:9px;background:var(--blue-soft);border-radius:10px;padding:12px;margin-top:1.4rem;color:var(--blue-deep);font-size:.82rem;font-weight:500}.process-outcome svg{flex-shrink:0}.process-step-card>.process-step-note{font-size:.77rem;margin-top:.9rem}
.process-prepare{background:var(--ink);color:#d4e0ef;padding:clamp(3rem,6vw,5rem) 0}.process-prepare-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem);align-items:center}.process-prepare .eyebrow{color:#abc5ff}.process-prepare .h2{color:#fff;margin-top:1rem;max-width:21ch}.process-prepare p{font-size:.95rem;line-height:1.7;margin-top:1.2rem;max-width:44ch}.process-prepare .btn{margin-top:1.8rem;background:#fff;color:var(--blue-deep)}.process-prepare ul{list-style:none;padding:0;margin:0}.process-prepare li{display:flex;align-items:flex-start;gap:18px;padding:1.5rem 0;border-bottom:1px solid #ffffff24}.process-prepare li>span{color:#a9c2ff;font-size:.8rem;padding-top:.2rem}.process-prepare h3{font-size:1.05rem;font-weight:500;color:#fff}.process-prepare li p{margin-top:.5rem;font-size:.88rem}
.process-faq-grid{display:grid;grid-template-columns:.8fr 1.4fr;gap:clamp(2rem,6vw,6rem)}.process-faq-grid>div>p{color:var(--ink-2);font-size:.95rem;max-width:36ch}.process-faq-grid .faq summary{font-size:1rem;line-height:1.5;padding-block:1rem}.process-faq-grid .faq p{font-size:.93rem}.process-faq-grid .faq .process-guide-link{margin:0 0 1rem}.process-next{background:var(--blue-soft);border-top:1px solid #d3def6;padding:3rem 0}.process-next>.wrap-wide{display:flex;justify-content:space-between;align-items:center;gap:2rem}.process-next .h2{margin-top:.8rem;font-size:clamp(1.8rem,3vw,2.7rem)}.process-next p{margin-top:.7rem;color:var(--ink-2);font-size:.95rem}.process-next-actions{display:flex;gap:.7rem;flex-wrap:wrap}
@media(max-width:900px){.process-hero-grid{gap:2rem}.process-hero h1{font-size:clamp(2.3rem,4.8vw,3.7rem)}.process-photo img{height:310px}.process-photo figcaption{flex-wrap:wrap;gap:.5rem}.process-layout,.process-faq-grid{grid-template-columns:1fr;gap:2.5rem}.process-guide{position:static}.process-guide>p{max-width:60ch}.process-guide nav{display:flex;flex-wrap:wrap;gap:8px;max-width:none}.process-guide nav a{border:1px solid var(--line);border-radius:8px;padding:8px 10px;min-height:44px;gap:8px}.process-guide nav a>span:last-child{display:none}.process-guide-link{margin-top:.7rem}.process-next>.wrap-wide{flex-direction:column;align-items:flex-start}}
@media(max-width:640px){.process-hero{padding:1rem 0 2.5rem}.process-hero-grid{grid-template-columns:1fr}.process-hero h1{font-size:clamp(2.3rem,8.5vw,3.4rem);max-width:20ch}.process-hero .lead{font-size:1rem}.process-hero .cta-row{flex-direction:column;align-items:stretch;gap:.7rem}.process-phone{justify-content:center}.process-photo{transform:none}.process-photo img{height:230px}.process-photo figcaption{flex-wrap:nowrap;font-size:.7rem;padding:.9rem}.process-photo strong{font-size:.8rem}.process-principles>.wrap-wide{grid-template-columns:1fr;gap:1.1rem;padding-block:1.5rem}.process-principles>.wrap-wide>div{gap:12px}.process-principles span{font-size:.77rem}.process-principles strong{font-size:.85rem}.process-timeline>li{grid-template-columns:32px minmax(0,1fr);gap:10px}.process-step-marker{width:32px;height:32px;font-size:.7rem}.process-timeline>li:not(:last-child)::before{left:15px;top:32px}.process-step-card{padding:1.2rem;border-radius:14px}.process-step-card h3{font-size:1.35rem}.process-step-card>p{font-size:.88rem}.process-outcome{font-size:.77rem;padding:10px}.process-step-top{font-size:.65rem;margin-bottom:1rem}.process-prepare-grid{grid-template-columns:1fr;gap:1.5rem}.process-faq-grid{gap:1.5rem}.process-next-actions{flex-direction:column;width:100%}.process-next-actions .btn{width:100%}}
@media(prefers-reduced-motion:reduce){.process-photo{transform:none}}
</style>

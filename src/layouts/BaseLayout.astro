---
import { COMPANY } from "../data/company";
import { buildSeo } from "../data/seo";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/design-system.css";
import "../styles/site-navigation.css";
import PhotoViewer from "../components/PhotoViewer.astro";

export interface Props {
  title: string;
  description: string;
  /** ruta canónica del silo, ej "/restoration/water-damage/" */
  path?: string;
  /** clase extra en <body> (ej "epage" para Emergency) */
  bodyClass?: string;
  noindex?: boolean;
}
const { title, description, path = "/", bodyClass = "", noindex = false } = Astro.props;
const { canonical, schema, image, isArticle } = buildSeo({ title, description, path, site: Astro.site! });
const preview = ["deploy-preview", "branch-deploy"].includes(process.env.CONTEXT || "");
const robots = noindex || preview ? "noindex, follow" : "index, follow, max-image-preview:large";
// Escape '<' so editorial text cannot terminate a JSON-LD script element.
const schemaJson = JSON.stringify(schema).replace(/</g, "\\u003c");

---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="/ppr-icon.png" />
  <link rel="apple-touch-icon" href="/ppr-icon.png" />
  <!-- Google Analytics 4 -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HW8CW41S53"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HW8CW41S53');
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:site_name" content={COMPANY.name} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={image.url} />
  <meta property="og:image:alt" content={image.alt} />
  {image.width && <meta property="og:image:width" content={image.width} />}
  {image.height && <meta property="og:image:height" content={image.height} />}
  <meta name="twitter:card" content={image.width ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image.url} />
  <meta name="twitter:image:alt" content={image.alt} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="robots" content={robots} />
  {!noindex && <script type="application/ld+json" set:html={schemaJson} />}
</head>
<body class={bodyClass}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Header />
  <main id="main-content" tabindex="-1"><slot /></main>
  <Footer />
  <nav class="mobile-actions" aria-label="Quick help">
    <a href={`tel:${COMPANY.phoneRaw}`} class="btn btn-primary">Call 24/7 <span aria-hidden="true">↗</span></a>
    <a href="/emergency/" class="btn btn-ghost">Request help</a>
  </nav>
  <PhotoViewer />
  <script is:inline type="module" src="/app.js"></script>
</body>
</html>

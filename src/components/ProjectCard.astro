---
import selectedProjects from '../data/selected-projects.json';
interface Props { project: (typeof selectedProjects)[number]; compact?: boolean; }
const { project, compact = false } = Astro.props;
const cover = project.photos[0];
---
{compact ? (
  <a class="work-preview" href={`/projects/#${project.id}`}>
    <div class="work-cover"><img src={cover.thumbnail} srcset={cover.thumbnail !== cover.src ? `${cover.thumbnail} ${cover.thumbnailWidth}w, ${cover.src} ${cover.width}w` : undefined} sizes="(max-width:540px) 100vw, (max-width:820px) 50vw, 33vw" alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" /><span class="work-location">{project.city}, FL</span></div>
    <div class="work-copy"><span class="eyebrow nodash">{project.category}</span><h3 class="h3">{project.title}</h3><span class="link-arrow">See project photos <span aria-hidden="true">↗</span></span></div>
  </a>
) : (
  <article class="work-entry" id={project.id} data-project data-city={project.citySlug}>
    <details>
      <summary>
        <div class="work-cover"><img src={cover.thumbnail} srcset={cover.thumbnail !== cover.src ? `${cover.thumbnail} ${cover.thumbnailWidth}w, ${cover.src} ${cover.width}w` : undefined} sizes="(max-width:540px) 100vw, (max-width:820px) 50vw, 33vw" alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" /><span class="work-location">{project.city}, FL</span></div>
        <div class="work-copy"><span class="eyebrow nodash">{project.category}</span><h2 class="h3">{project.title}</h2><p>{project.summary}</p><span class="link-arrow"><span class="work-expand">View {project.photos.length === 1 ? 'photo' : `${project.photos.length} photos`}</span><span class="work-collapse">Close photos</span><span aria-hidden="true">+</span></span></div>
      </summary>
      <div class="work-photos">
        {project.photos.map(photo => <figure><a href={photo.src} target="_blank" rel="noopener" aria-label={`Open full photo: ${photo.alt}`}><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></a><figcaption>{photo.alt}</figcaption></figure>)}
        <p class="small">Select a photo to open the full image.</p>
      </div>
    </details>
  </article>
)}

---
import { RESTORATION_STEPS } from '../data/restoration-process';
const summaries = [
  'Share your location and the damage. Discuss availability and the next step.',
  'Review affected materials, observed conditions and the proposed work.',
  'Agree on the work needed to limit further damage.',
  'Track progress using the treatment and checks appropriate to the loss.',
  'Review completed work, project records and any remaining responsibilities.',
];
---
<div class="process-overview mt-l">{RESTORATION_STEPS.map((step,index) => <div class="proc reveal"><div class="proc-no">0{index+1}</div><h3 class="h3">{step.label}</h3><p>{summaries[index]}</p></div>)}</div>
<a class="link-arrow mt-m" href="/our-process/">Explore the five-step process <span aria-hidden="true">→</span></a>
<style>.process-overview{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1rem}.process-overview .proc{min-width:0}.process-overview .h3{font-size:1.15rem}@media(max-width:1100px){.process-overview{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:820px){.process-overview{grid-template-columns:1fr 1fr}}@media(max-width:540px){.process-overview{grid-template-columns:1fr}}</style>

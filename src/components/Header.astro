---
import { COMPANY, SERVICES } from "../data/company";
import Icon from "./Icon.astro";
const currentPath = Astro.url.pathname.replace(/\/?$/, "/");
const isCurrent = (url: string) => currentPath.startsWith(url);
const links = [
  { label: "Service Areas", url: "/service-areas/" },
  { label: "Our Work", url: "/projects/" },
  { label: "Our Process", url: "/our-process/" },
  { label: "Resources", url: "/resources/" },
];
const servicesActive = isCurrent("/restoration/") || isCurrent("/commercial/");
---
<div class="util">
  <div class="wrap-wide">
    <div class="util-left"><span><i class="dot"></i> 24/7 emergency contact</span><span>IICRC Certified</span><span>Fully Insured &amp; Bonded</span></div>
    <div class="util-right"><a href="/insurance-claims/">Insurance claim support <span aria-hidden="true">↗</span></a></div>
  </div>
</div>
<header class="head">
  <div class="wrap-wide head-in">
    <a href="/" class="brand" aria-label={`${COMPANY.name} home`}><img src="/ppr-logo.png" alt="Paramount Property Restoration" width="1024" height="315" /></a>
    <nav class="nav" aria-label="Main navigation">
      <div class="has-menu">
        <button data-services-toggle data-active={servicesActive ? "true" : undefined} aria-expanded="false" aria-controls="services-dropdown" type="button">Services <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></button>
        <div class="dropdown" id="services-dropdown" inert>
          <div class="dd-heading">How can we help your property?</div>
          {SERVICES.map(s => <a class="dd-item" href={s.url} aria-current={currentPath === s.url ? "page" : undefined}><span class="dd-icon"><Icon name={s.icon} size={22} /></span><span class="dd-copy"><span class="t">{s.short}</span><span class="d">{s.desc}</span></span></a>)}
          <div class="dd-foot"><a href="/restoration/">Explore all services <span aria-hidden="true">→</span></a><a href="/contact/">Not sure? Talk to us</a></div>
        </div>
      </div>
      {links.map(link => <a href={link.url} aria-current={currentPath === link.url ? "page" : isCurrent(link.url) ? "location" : undefined}>{link.label}</a>)}
    </nav>
    <div class="head-cta">
      <div class="head-phone"><div class="l">Talk to our team · 24/7</div><a class="n" href={`tel:${COMPANY.phoneRaw}`}>{COMPANY.phone}</a></div>
      <a href="/emergency/" class="btn btn-alert">Get Help Now <span class="head-arrow" aria-hidden="true">↗</span></a>
      <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-navigation" type="button"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
<nav class="mnav" id="mobile-navigation" aria-label="Mobile navigation" inert>
  <div class="mobile-menu-inner">
    <div class="mobile-menu-intro">How can we help?</div>
    <div class="grp">Restoration services</div>
    <div class="mobile-service-links">{SERVICES.map(s => <a href={s.url} aria-current={currentPath === s.url ? "page" : undefined}><Icon name={s.icon} size={20} /><span>{s.short}</span></a>)}</div>
    <div class="grp">Explore Paramount</div>
    <div class="mobile-explore-links">{links.map(link => <a href={link.url} aria-current={currentPath === link.url ? "page" : isCurrent(link.url) ? "location" : undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}<a href="/insurance-claims/">Insurance Claims <span aria-hidden="true">↗</span></a><a href="/contact/">Contact <span aria-hidden="true">↗</span></a></div>
    <a class="mobile-menu-call" href={`tel:${COMPANY.phoneRaw}`}><Icon name="phone" size={22} /><span><small>24/7 emergency contact</small>{COMPANY.phone}</span></a>
  </div>
</nav>

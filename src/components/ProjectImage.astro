---
import type { ProjectImage } from '../data/project-imagery';
interface Props { image: ProjectImage; class?: string; eager?: boolean; sizes?: string; position?: string; }
const { image, class: klass, eager = false, sizes = '(max-width: 880px) 100vw, 55vw', position = 'center' } = Astro.props;
---
<img class={klass} src={image.thumbnail} srcset={`${image.thumbnail} ${image.thumbnailWidth}w, ${image.src} ${image.width}w`} sizes={sizes} alt={image.alt} width={image.width} height={image.height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" style={`object-position:${position}`} />
